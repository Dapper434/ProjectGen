# Copy this file to .env and fill in real values.
# .env is gitignored and auto-loaded on every `flask run` / server restart —
# no need to `export` these in your shell each time.
#
# Every key below is read exactly once, in backend/config.py — that module is
# the single source of truth for env-level config; nothing else should call
# os.environ.get() directly for a value listed here.

# --- core ------------------------------------------------------------------

# Used to sign session cookies. Defaults to a fixed demo value if unset (fine
# for local dev, should be a real random value everywhere else) —
# python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Optional — defaults to sqlite:///factoryos.db if unset.
DATABASE_URL=

# Set to 1 in production — turns on Secure + SameSite=Lax session cookies.
# Leave unset in local dev (plain http).
PRODUCTION=

# Optional — the frontend's own origin. Not yet consumed by any route.
APP_BASE_URL=

# Optional — where uploaded files land on disk. Not yet consumed by any route.
UPLOAD_DIR=

# --- NVIDIA NIM (brief/proposal generation) ---------------------------------

# Without this, Brief/Proposal generation falls back to generic placeholder
# content instead of real AI-generated output.
NIM_API_KEY=

# Optional — defaults to nvidia/nemotron-3-super-120b-a12b if unset.
NIM_MODEL=

# Optional — the NIM chat-completions base URL. Change only if NVIDIA moves it.
NIM_BASE_URL=

# --- Fathom (transcript inbox webhook) --------------------------------------

# Only needed to register/delete webhooks via `python3 fathom.py register ...`.
FATHOM_API_KEY=

# The `secret` returned when the webhook is created (starts with "whsec_").
# When set, incoming webhook requests are HMAC-verified; when unset, the
# endpoint accepts unsigned requests (dev/demo only).
FATHOM_WEBHOOK_SECRET=

# --- model providers: not yet wired up (WP-2 provider registry) ------------

# Optional — a cheaper/smaller NIM model for high-frequency calls (e.g.
# boardroom coverage checks every 90s). Blank means "use NIM_MODEL".
NIM_SMALL_MODEL=

GROQ_API_KEY=
# Optional — defaults to llama-3.3-70b-versatile if unset.
GROQ_LLM_MODEL=

# Optional — local Ollama server for the polish/agent_llm drivers.
OLLAMA_BASE_URL=
# Optional — defaults to qwen2.5:7b-instruct if unset.
OLLAMA_MODEL=

# --- speech (WP-4) ----------------------------------------------------------
# Requires ffmpeg on the server for the post-meeting path: apt install ffmpeg
# (used to normalise any container to 16 kHz mono and split it into pieces that
# fit the 25 MB per-request ceiling both Groq and Whisper share).

# Optional — defaults to whisper-large-v3-turbo if unset.
GROQ_STT_MODEL=

# Optional — local faster-whisper server (OpenAI-compatible) for offline STT.
WHISPER_BASE_URL=
# Optional — defaults to Systran/faster-whisper-small if unset.
WHISPER_MODEL=

WISPRFLOW_API_KEY=

# Keep raw audio after transcription instead of deleting it. Default false.
STT_KEEP_AUDIO=

# Per-user daily transcription budget in seconds. Default 7200 (2 hours).
STT_DAILY_SECONDS_PER_USER=

# --- email: not yet wired up (WP-12 reviewed-then-emailed delivery) --------

SENDGRID_API_KEY=
POSTMARK_SERVER_TOKEN=
RESEND_API_KEY=
# Optional — defaults to proposals@gdfkenya.com if unset.
EMAIL_FROM=

# --- default driver per capability: not yet consumed (WP-2 Lab overrides
# these at runtime, but the env value here is the floor every deploy boots
# with) ----------------------------------------------------------------------

STT_LIVE_DRIVER=
STT_BATCH_DRIVER=
POLISH_DRIVER=
AGENT_LLM_DRIVER=
COVERAGE_LLM_DRIVER=
EMAIL_DRIVER=
CLIENT_MATCH_DRIVER=

# --- feature flags: all default false, enable one at a time -----------------
# A disabled feature 404s rather than 403s — indistinguishable from not existing.

FEATURE_AUTH_DATA=
FEATURE_LAB=
FEATURE_VOICE=
FEATURE_RECORDINGS=
FEATURE_BOARDROOM=
FEATURE_TALENT=
FEATURE_TALENT_PORTAL=
FEATURE_EMAIL=
