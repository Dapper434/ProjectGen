# Copy this file to .env and fill in real values.
# .env is gitignored and auto-loaded on every `flask run` / server restart —
# no need to `export` these in your shell each time.

# NVIDIA NIM API key. Without this, Brief/Proposal generation falls back to
# generic placeholder content instead of real AI-generated output.
NIM_API_KEY=

# Optional — defaults to meta/llama-3.1-70b-instruct if unset.
NIM_MODEL=

# Optional — used to sign session cookies. Defaults to a fixed demo value if unset
# (fine for local dev, should be set to a real random value for anything else).
SECRET_KEY=

# Optional — defaults to sqlite:///factoryos.db if unset.
DATABASE_URL=
